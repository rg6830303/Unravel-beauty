# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=            # System User permanent token
WA_APP_SECRET=              # App > Settings > Basic > App Secret (webhook signature check)
WA_VERIFY_TOKEN=            # any random string, same value entered in Meta webhook config
WA_API_VERSION=v21.0

# AI auto-reply (Anthropic)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_SYSTEM_PROMPT="You are the friendly WhatsApp assistant for ACME. Answer briefly. If you cannot help, say a human will follow up."

# Dashboard login + cron protection
DASHBOARD_PASSWORD=
CRON_SECRET=
